# Copy to .env (git-ignored). `make up P=01` does this for you the first time and replaces every
# __GENERATE__ with a random value. Placeholders only here; never commit real values.
# Keys added here later are not copied into an existing .env; add them by hand.
# Setup guide for the live sandboxes: docs/live-sandbox-setup.md

# --- Gateway --------------------------------------------------------------------------------------
# Host port for the MCP gateway (published on 127.0.0.1 only): http://localhost:${GATEWAY_PORT}/mcp
GATEWAY_PORT=8765

# Backend per system. seed = offline synthetic Ridgeline data (default; runs the demo scenarios).
CRM_BACKEND=seed             # seed | salesforce
ERP_BACKEND=seed             # seed | sap_sandbox
CARRIER_BACKEND=http         # seed | http (the mock carrier API container)
AR_BACKEND=http              # seed | http (the mock AR API container)

# --- Salesforce Developer Edition (CRM_BACKEND=salesforce) -----------------------------------------
# External Client App with the OAuth 2.0 client credentials flow. See docs/live-sandbox-setup.md.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v62.0

# --- SAP Business Accelerator Hub sandbox (ERP_BACKEND=sap_sandbox) ---------------------------------
SAP_API_KEY=
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV

# --- Mock carrier and AR APIs (Docker Compose, internal network only) -------------------------------
CARRIER_API_KEY=__GENERATE__
AR_API_TOKEN=__GENERATE__

# --- Tests ----------------------------------------------------------------------------------------
# tests/test_gateway_http.py uses GATEWAY_URL, else http://localhost:${GATEWAY_PORT:-8765}, from the
# process environment. `make test` does not read .env, so export these if you change the port.
# REQUIRE_GATEWAY=1 makes those tests fail (instead of skip) when the gateway is down.
GATEWAY_URL=http://localhost:8765
REQUIRE_GATEWAY=0
