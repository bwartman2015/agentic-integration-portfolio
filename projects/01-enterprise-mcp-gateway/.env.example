# `make up P=01` creates .env (git-ignored) from this file and fills every __GENERATE__ with a random
# value. On later runs it appends any __GENERATE__ key your .env lacks (existing values are never
# changed). Don't create .env with `cp`. Placeholders only here; never commit real values.
# Setup guide for the live sandboxes: docs/live-sandbox-setup.md

# --- Gateway --------------------------------------------------------------------------------------
# Host port for the MCP gateway (published on 127.0.0.1 only): http://localhost:${GATEWAY_PORT}/mcp
GATEWAY_PORT=8765

# Backend per system. seed = offline synthetic Ridgeline data (default; runs the demo scenarios).
CRM_BACKEND=seed             # seed | salesforce
ERP_BACKEND=seed             # seed | sap_sandbox
CARRIER_BACKEND=http         # seed | http (the mock carrier API container)
AR_BACKEND=http              # seed | http (the mock AR API container)

# --- Salesforce Developer Edition (CRM_BACKEND=salesforce) -----------------------------------------
# External Client App with the OAuth 2.0 client credentials flow. See docs/live-sandbox-setup.md.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v62.0

# --- SAP Business Accelerator Hub sandbox (ERP_BACKEND=sap_sandbox) ---------------------------------
SAP_API_KEY=
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV

# --- Identity: Keycloak (Milestone 3) ----------------------------------------------------------------
# Admin console http://localhost:${KEYCLOAK_PORT}/ (user `admin`). Every /mcp call needs a token from here.
KEYCLOAK_PORT=8080
KC_ADMIN_PASSWORD=__GENERATE__
# Agent client secrets (OAuth 2.0 client credentials). They reach Keycloak and the one-off ops container only.
CS_REP_CLIENT_SECRET=__GENERATE__
CS_LEAD_CLIENT_SECRET=__GENERATE__
P01_EXPIRY_TEST_CLIENT_SECRET=__GENERATE__
P01_CRM_ONLY_TEST_CLIENT_SECRET=__GENERATE__

# --- Authorization: OPA (Milestone 4) -----------------------------------------------------------------
# Nothing to configure: Compose starts OPA on an internal network with the policy in policy/ and points
# the gateway at it (OPA_URL, OPA_TIMEOUT_S). Rego unit tests: make opa-test P=01

# --- Guardrails, audit, approvals (Milestone 5) -------------------------------------------------------
# Audit log (Postgres, internal network). The admin password stays with the database container; the
# gateway uses the second one, for a role that can add and read audit rows but not change them.
AUDIT_DB_ADMIN_PASSWORD=__GENERATE__
AUDIT_DB_PASSWORD=__GENERATE__
# Optional: keep the audit log in a hosted Postgres (e.g. Neon) instead of the local container, and
# (Milestone 6) the copilot's pgvector memory with it. Leave empty for the local database (the default
# for `make up` and the tests). A remote URL must include sslmode=require; verify-full also checks the
# server's certificate and is recommended for Neon. Setup and the one-time
# `make audit-init P=01`: docs/live-sandbox-setup.md. These are secrets: they live only in .env.
DATABASE_URL=
# Used only by `make audit-init` / `make audit-role` (an owner role's URL). `neon init` writes the owner's
# direct URL as DATABASE_URL_UNPOOLED, which they use when this is empty.
DATABASE_ADMIN_URL=
# After `make audit-role`, keep Neon from overwriting DATABASE_URL: `neon env pull --file .env.neon`,
# `neon deploy --no-env-pull`, `neon checkout <branch> --no-env-pull`.
# Human approval of write tools (n8n). Approval forms open at http://localhost:${N8N_PORT}/
N8N_PORT=5678
N8N_ENCRYPTION_KEY=__GENERATE__
# Seconds a write waits for a human decision before it is refused.
APPROVAL_TIMEOUT_S=120
# Operator credential for `make approvals` (lists pending requests with their approval links). No agent
# client holds it.
APPROVAL_OPERATOR_TOKEN=__GENERATE__
# Shared secret the gateway sends to n8n's approval webhook; n8n refuses requests without it.
APPROVAL_WEBHOOK_SECRET=__GENERATE__
# Tool calls per minute for each agent client.
RATE_LIMIT_PER_MINUTE=120
# Test-only client with a very low rate limit.
P01_RATE_TEST_CLIENT_SECRET=__GENERATE__
# Operator identity for `make audit` (scope audit.read only; no agent holds it).
P01_AUDITOR_CLIENT_SECRET=__GENERATE__

# --- Mock carrier and AR APIs (Docker Compose, internal network only) -------------------------------
CARRIER_API_KEY=__GENERATE__
AR_API_TOKEN=__GENERATE__

# --- Tests ----------------------------------------------------------------------------------------
# tests/test_gateway_http.py uses GATEWAY_URL, else http://localhost:${GATEWAY_PORT:-8765}, from the
# process environment. `make test` does not read .env, so export these if you change the port.
# REQUIRE_GATEWAY=1 makes those tests fail (instead of skip) when the gateway is down.
GATEWAY_URL=http://localhost:8765
REQUIRE_GATEWAY=0
